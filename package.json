{
  "name": "xike",
  "productName": "息刻",
  "version": "0.4.0",
  "description": "息刻 · Windows 桌面健康提醒",
  "author": "息刻",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "pnpm build && node scripts/ui-test.mjs",
    "check": "tsc --noEmit",
    "pack": "pnpm build && electron-builder --win --x64 --dir",
    "dist": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "koffi": "3.3.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.4.1",
    "electron-builder": "latest",
    "esbuild": "latest",
    "playwright": "^1.65.1",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "cn.xike.desktop",
    "productName": "息刻",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "息刻",
      "artifactName": "Xike-Setup-${version}.${ext}"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
